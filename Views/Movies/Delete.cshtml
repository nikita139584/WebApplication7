@model mvc.Movie

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Удалить</h1>

<h3>Вы уверены, что хотите удалить это?</h3>
<div>
    <h4>Фильмы</h4>
    <hr />
    <dl class="row">
        <dd class="col-sm-2">Название</dd>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dd class="col-sm-2">Режиссёр</dd>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.director)
        </dd>
        <dd class="col-sm-2">Жанр</dd>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.genre)
        </dd>
        <dd class="col-sm-2">Постер</dd>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.poster)
        </dd>
        <dd class="col-sm-2">Описание</dd>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.description)
        </dd>
    </dl>

    <form asp-action="Удалить">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Удалить" class="btn btn-danger" /> |
        <a asp-action="Index">Вернуться к списку</a>
    </form>
</div>
