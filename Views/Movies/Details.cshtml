@model mvc.Movie
@{
    ViewData["Title"] = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Детали</h1>

<div>
    <h4>Фильмы</h4>
    <hr />
    <dl class="row">
        <dd class="col-sm-2">Название</dd>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dd class="col-sm-2">Режиссёр</dd>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.director)
        </dd>
        <dd class="col-sm-2">Жанр</dd>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.genre)
        </dd>
        <dd class="col-sm-2">Ссылка на постер</dd>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.poster)
        </dd>   
         <dd class="col-sm-2">Описание</dd>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.description)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Редактировать</a> |
    <a asp-action="Index">Вернуться к списку</a>
</div>
